{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "HUD 与设置窗口所需的最小权限集合",
  "windows": ["hud", "settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-position",
    "notification:default",
    "opener:default"
  ]
}
